APP_NAME=ChandakText
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not PostgreSQL/sqlite - see docs/PROGRESS.md for why. A few
# features (FULLTEXT search, a raw ALTER TABLE ... ADD FULLTEXT in a
# migration) are MySQL-specific.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chandaktext
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis is Laravel's own default and the right choice if
# the `redis` PHP extension is installed. If it isn't (this project's dev
# machine has no ext-redis), use `predis` instead - the predis/predis
# composer package is already required.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- ChandakText-specific configuration (BE-008) ------------------------

# Web app origin, for places that need to build a link back to it
# (password reset emails, etc).
FRONTEND_URL=http://localhost:5173

# Comma-separated list of hosts allowed to make stateful (cookie-based)
# Sanctum requests. Not actually used by this app today - auth is pure
# bearer-token for both web and mobile - kept here because Sanctum's own
# config reads it; harmless if unused.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# SEC-006: how long an issued bearer token stays valid. See config/sanctum.php.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# docs/06 billing: `fake` (default, safe for local/dev/CI - no real payment
# provider involved) or `razorpay` (requires the keys below).
PAYMENT_PROVIDER=fake
FAKE_PAYMENTS_WEBHOOK_SECRET=fake-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seeded by database/seeders/SuperAdminSeeder.php - the only account that
# can log into /admin until you promote another user there.
SUPER_ADMIN_EMAIL=admin@chandaktext.test
SUPER_ADMIN_PASSWORD=password

# Plan limits seeded by database/seeders/PlanSeeder.php. These are also
# editable afterwards from the Filament admin panel (Plans resource) -
# these env values only set the STARTING point.
PLAN_FREE_PROJECTS=3
PLAN_FREE_STORAGE_MB=500
PLAN_FREE_DOCS_PER_PROJECT=10
PLAN_PRO_PROJECTS=100
PLAN_PRO_STORAGE_MB=20000
PLAN_PRO_DOCS_PER_PROJECT=500

# How long a completed export's download link stays valid.
EXPORT_LINK_TTL_MINUTES=30

# BUG-003: how long a soft-deleted document (and its file/excerpts/
# annotations) is kept before App\Console\Commands\PurgeSoftDeletedDocuments
# removes it permanently.
DOCUMENT_RETENTION_DAYS=30

# Share links (PROD-002): how long a new one lives by default, and the
# hard ceiling on a caller-requested longer expiry.
SHARE_LINK_DEFAULT_DAYS=7
SHARE_LINK_MAX_DAYS=90

# AI assistant (Section 15: provider/privacy/budget was explicitly the
# user's call, not Claude's, to make). 'fake' needs no key and is a
# deterministic local stand-in - set to 'openai' or 'anthropic' and the
# matching key below to use a real provider.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

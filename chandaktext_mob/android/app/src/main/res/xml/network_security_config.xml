<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP only to the local dev backend (Android emulator's
  10.0.2.2 alias for the host machine, plus localhost for a device on the
  same network reachable over plain HTTP during development). Production
  builds must point API_URL at an https:// backend - see docs/09 deployment
  checklist "TLS" - at which point this cleartext allowance for real
  traffic is irrelevant (it only ever applies to these specific hosts).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

# Baked in at build time by Vite (npm run build) - not read at runtime.
# Must point at the real backend API before building for production; the
# code falls back to the local-dev URL below if this is unset
# (web/src/lib/api.ts), which is only correct on this dev machine.
VITE_API_URL=http://127.0.0.1:8123/api/v1
